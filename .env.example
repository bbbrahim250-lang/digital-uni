# Base URL
NEXT_PUBLIC_BASE_URL=https://www.digital-uni.net

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API (authorized embeds/metadata only — Section 10)
YOUTUBE_DATA_API_KEY=

# Translation provider (Section 11)
TRANSLATION_PROVIDER_API_KEY=

# Email service (contact forms, notifications)
# Resend API credentials. The sender/domain must be verified by Resend.
EMAIL_SERVICE_API_KEY=
EMAIL_FROM_ADDRESS=

# Cloudflare Turnstile (Santa Monica AI High School support form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (consent-aware — Section 24)
NEXT_PUBLIC_ANALYTICS_ID=
# Optional provider-hosted checkout configuration. Keep provider secrets in Vercel
# environment variables; never expose secret keys through NEXT_PUBLIC_ variables.
STRIPE_CHECKOUT_URL=
PAYPAL_CHECKOUT_URL=
CRYPTO_CHECKOUT_URL=

# Applicant Planning Assistant (server-side only; configure in Vercel, never NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# A random value of at least 32 bytes used to prevent browser-side plan tampering.
APPLICANT_PLAN_SIGNING_SECRET=
