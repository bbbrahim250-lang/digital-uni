# Base URL
NEXT_PUBLIC_BASE_URL=https://www.digital-uni.net

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API (authorized embeds/metadata only — Section 10)
YOUTUBE_DATA_API_KEY=

# Translation provider (Section 11)
TRANSLATION_PROVIDER_API_KEY=

# Email service (contact forms, notifications)
# Resend API credentials. The sender/domain must be verified by Resend.
# Vercel Marketplace provisions RESEND_API_KEY automatically. The legacy
# EMAIL_SERVICE_API_KEY name remains supported for existing deployments.
RESEND_API_KEY=
EMAIL_SERVICE_API_KEY=
EMAIL_FROM_ADDRESS=

# Optional authenticated SMTP fallback. For Turbify Business Email, use
# smtp.bizmail.yahoo.com on port 465 with SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Cloudflare Turnstile (Santa Monica AI High School support form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (consent-aware — Section 24)
NEXT_PUBLIC_ANALYTICS_ID=
# Optional provider-hosted checkout configuration. Keep provider secrets in Vercel
# environment variables; never expose secret keys through NEXT_PUBLIC_ variables.
STRIPE_CHECKOUT_URL=
PAYPAL_CHECKOUT_URL=
CRYPTO_CHECKOUT_URL=

# Digital-UNI Store. Prices are public display text (for example, "$25 USD").
# Checkout values must be provider-hosted payment links, never secret API keys.
STORE_EXPLORATORY_STUDENT_PRICE=
STORE_EXPLORATORY_STUDENT_CHECKOUT_URL=
STORE_EXPLORATORY_STAFF_PRICE=
STORE_EXPLORATORY_STAFF_CHECKOUT_URL=
STORE_SHARKS_SHIRT_PRICE=
STORE_SHARKS_SHIRT_CHECKOUT_URL=
# Optional campus-specific values. When omitted, the general Sharks shirt
# price and checkout link above are used for both collections.
STORE_SANTA_MONICA_SHARKS_SHIRT_PRICE=
STORE_SANTA_MONICA_SHARKS_SHIRT_CHECKOUT_URL=
STORE_PALO_ALTO_SHARKS_SHIRT_PRICE=
STORE_PALO_ALTO_SHARKS_SHIRT_CHECKOUT_URL=
STORE_DIGITAL_UNI_SHIRT_PRICE=
STORE_DIGITAL_UNI_SHIRT_CHECKOUT_URL=
STORE_ACCESSORIES_PRICE=
STORE_ACCESSORIES_CHECKOUT_URL=
# Official public Amazon storefront URL (HTTPS only).
DIGITAL_UNI_AMAZON_SHOP_URL=

# Applicant Planning Assistant (server-side only; configure in Vercel, never NEXT_PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# A random value of at least 32 bytes used to prevent browser-side plan tampering.
APPLICANT_PLAN_SIGNING_SECRET=
